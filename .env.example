# ==============================================================================
# CeylonHosting Environment Configuration
# ==============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=https://ceylonhosting.tech
CORS_ALLOWED_ORIGIN=https://ceylonhosting.tech

# Supabase (PostgreSQL Database & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Realtime Server (Optional)
NEXT_PUBLIC_REALTIME_URL=https://realtime.ceylonhosting.tech
REALTIME_PORT=4001
REALTIME_INTERNAL_SECRET=

# Admin Credentials
ADMIN_DEFAULT_EMAIL=admin@ceylonhosting.tech
ADMIN_DEFAULT_PASSWORD=change-me-local

# PaymentsLK Gateway
PAYMENTS_LK_SECRET_KEY=sk_test_replace_me
PAYMENTS_LK_WEBHOOK_SECRET=whsec_replace_me
PAYMENTS_LK_SUCCESS_PATH=/checkout/success
PAYMENTS_LK_CANCEL_PATH=/?cart=1

# Email Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=ceylonhosting@proton.me

# Storage & Security
PRODUCT_FILES_ROOT=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
CRON_SECRET=
