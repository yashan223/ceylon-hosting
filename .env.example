# ==============================================================================
# CeylonHosting — Environment Configuration Template
# Copy this file to .env.local (for local dev) or configure in Vercel Project Settings
# ==============================================================================

# Application URL & CORS
NEXT_PUBLIC_APP_URL=https://ceylonhosting.tech
CORS_ALLOWED_ORIGIN=https://ceylonhosting.tech

# Supabase (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication
ADMIN_DEFAULT_EMAIL=ceylonhosting@proton.me
ADMIN_DEFAULT_PASSWORD=change-me-in-production

# PaymentsLK Gateway
PAYMENTS_LK_SECRET_KEY=sk_test_replace_me
PAYMENTS_LK_WEBHOOK_SECRET=whsec_replace_me
PAYMENTS_LK_SUCCESS_PATH=/checkout/success
PAYMENTS_LK_CANCEL_PATH=/?cart=1

# Email Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=ceylonhosting@proton.me

# Automated Background Jobs
CRON_SECRET=

# Realtime WebSocket (Optional)
NEXT_PUBLIC_REALTIME_URL=

# Private File Storage (Optional local filesystem path)
PRODUCT_FILES_ROOT=
