{
  "name": "ceylonhosting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "build:low-mem": "NODE_OPTIONS=--max-old-space-size=1536 next build",
    "start": "next start -p 4000",
    "deploy": "bash deploy.sh",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose stop mongodb",
    "db:logs": "docker compose logs -f mongodb",
    "db:status": "docker compose ps mongodb"
  },
  "dependencies": {
    "@payments-lk/node": "https://payments.lk/sdks/payments-lk-node-0.2.0.tgz",
    "cn": "^0.3.0",
    "dotenv": "^18.0.1",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "next": "16.3.5",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
